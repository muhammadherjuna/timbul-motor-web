generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String?
  role      String   @default("ADMIN") // ADMIN, MECHANIC, SUPERVISOR
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inspections  MotorInspection[]
  sales        MotorPricing[]
  transactions Transaction[]     @relation("UserTransactions")
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  contact   String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pricings MotorPricing[]
}

model Motor {
  id   String @id @default(uuid())
  code String @unique

  // Tab 1: Identitas & Spesifikasi
  location     String?
  brand        String
  name         String
  type         String
  variant      String?
  year         Int
  color        String
  cc           Int
  transmission String
  fuel_system  String?
  key_type     String?
  km           Int

  // Tab 5: Foto & Video
  image            String
  images           String[]
  media_json       Json?
  videoUrl         String?
  video_cold_start String?

  description String

  status String // Draft, Tersedia, Sedang Dipesan, Terjual

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  document           MotorDocument?
  history            MotorHistory?
  inspection         MotorInspection?
  pricing            MotorPricing?
  inspectionSessions InspectionSession[]
  transaction        Transaction?
}

model MotorDocument {
  id      String @id @default(uuid())
  motorId String @unique
  motor   Motor  @relation(fields: [motorId], references: [id], onDelete: Cascade)

  plate_number   String?
  plate_area     String?
  tax_status     String
  tax_expiry     String
  stnk_expiry    String?
  stnk_status    String?
  bpkb_status    String?
  chassis_number String?
  engine_number  String?
  chassis_match  String?
  engine_match   String?
  faktur         String?
  ktp_owner      String?
  block_status   String?
  etle_status    String?

  bpkb_ready Boolean @default(true)
  stnk_ready Boolean @default(true)
}

model MotorHistory {
  id      String @id @default(uuid())
  motorId String @unique
  motor   Motor  @relation(fields: [motorId], references: [id], onDelete: Cascade)

  previous_owners String?
  usage_type      String?
  service_history String?
  last_service_km Int?
  crash_history   String?
  flood_history   String?
  engine_rebuild  String?
  modifications   String?
  odo_status      String?
}

model MotorInspection {
  id      String @id @default(uuid())
  motorId String @unique
  motor   Motor  @relation(fields: [motorId], references: [id], onDelete: Cascade)

  inspectorId    String?
  inspector      User?   @relation(fields: [inspectorId], references: [id], onDelete: SetNull)
  inspector_name String?

  inspection_grade  String?
  engine_start      String?
  engine_sound      String?
  cvt_chain         String?
  electrical_lights String?
  brakes            String?
  suspension        String?
  body_paint        String?
  test_drive        String?
  notes             String?
  repair_cost_est   Int?
  body_condition    String?
  engine_condition  String?

  archived Boolean @default(false)
}

model MotorPricing {
  id      String @id @default(uuid())
  motorId String @unique
  motor   Motor  @relation(fields: [motorId], references: [id], onDelete: Cascade)

  price           Int
  credit_price    Int?
  is_nego         Boolean @default(true)
  dp_min          Int
  tenor_options   String?
  monthly_install Int?
  warranty        String?
  trade_in_avail  Boolean @default(true)

  purchase_price   Int?
  recondition_cost Int?
  margin_target    Int?

  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplier_name String?

  salesId   String?
  sales     User?   @relation(fields: [salesId], references: [id], onDelete: SetNull)
  sales_rep String?

  internal_notes String?
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  address   String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------
// SMART INSPECTION SYSTEM
// -----------------------------------------

enum ItemAnswerStatus {
  NORMAL
  PERLU_PERBAIKAN
  RUSAK
  PERLU_GANTI
  LENGKAP
  TIDAK_LENGKAP
  BELUM_DIPERIKSA
  TIDAK_BERLAKU
}

model InspectionPackage {
  id          String   @id @default(uuid())
  name        String
  description String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  categories InspectionCategory[]
  sessions   InspectionSession[]
}

model InspectionCategory {
  id         String            @id @default(uuid())
  packageId  String
  package    InspectionPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  name       String
  weight     Float
  orderIndex Int

  items InspectionPackageItem[]
}

model InspectionPackageItem {
  id             String             @id @default(uuid())
  categoryId     String
  category       InspectionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  itemKey        String // unique slug
  question       String
  weight         Float
  isSafetyItem   Boolean            @default(false)
  isCriticalItem Boolean            @default(false)
  isActive       Boolean            @default(true)
  orderIndex     Int

  inspectionItems InspectionItem[]
}

model InspectionSession {
  id        String            @id @default(uuid())
  motorId   String
  motor     Motor             @relation(fields: [motorId], references: [id], onDelete: Cascade)
  packageId String
  package   InspectionPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)

  status String // DRAFT | IN_PROGRESS | COMPLETED | APPROVED | REJECTED | REOPENED

  totalScore      Float?
  grade           String? // A | B | C | D
  hasCritical     Boolean @default(false)
  saleEligibility String? // LAYAK_JUAL | PERLU_PERBAIKAN | TIDAK_LAYAK

  inspectorId   String?
  inspectorName String?

  approvedById   String?
  approvedByName String?
  approvalNote   String?
  approvedAt     DateTime?

  rejectedById   String?
  rejectedByName String?
  rejectionNote  String?
  rejectedAt     DateTime?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  items    InspectionItem[]
  snapshot InspectionSessionItemSnapshot[]
  events   InspectionSessionEvent[]
}

model InspectionSessionEvent {
  id        String            @id @default(uuid())
  sessionId String
  session   InspectionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  actorId   String?
  actorName String?
  type      String            // e.g. "APPROVED", "REJECTED", "REVOKED", "COMPLETED", "REOPENED"
  note      String?
  createdAt DateTime          @default(now())
}

model InspectionSessionItemSnapshot {
  id        String            @id @default(uuid())
  sessionId String
  session   InspectionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Frozen data
  itemKey        String
  question       String
  categoryName   String
  originalWeight Float
  isSafetyItem   Boolean
  isCriticalItem Boolean
  orderIndex     Int
}

model InspectionItem {
  id            String                @id @default(uuid())
  sessionId     String
  session       InspectionSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  packageItemId String
  packageItem   InspectionPackageItem @relation(fields: [packageItemId], references: [id], onDelete: Restrict)

  answer String?
  status ItemAnswerStatus @default(BELUM_DIPERIKSA)
  score  Float?

  notes        String?
  repairStatus String    @default("PERLU_PERBAIKAN") // PERLU_PERBAIKAN | SUDAH_DIPERBAIKI | SEBAGAIMANA_ADANYA
  repairNote   String?
  repairedAt   DateTime?
  reVerifiedAt DateTime?
  reVerifiedBy String?

  evidence InspectionEvidence[]
  history  InspectionItemHistory[]
}

model InspectionItemHistory {
  id               String           @id @default(uuid())
  inspectionItemId String
  inspectionItem   InspectionItem   @relation(fields: [inspectionItemId], references: [id], onDelete: Cascade)
  oldAnswer        String?
  oldStatus        ItemAnswerStatus
  newAnswer        String?
  newStatus        ItemAnswerStatus
  changedBy        String?
  changedAt        DateTime         @default(now())
}

model InspectionEvidence {
  id               String         @id @default(uuid())
  inspectionItemId String
  inspectionItem   InspectionItem @relation(fields: [inspectionItemId], references: [id], onDelete: Cascade)

  storagePath String
  isPublic    Boolean  @default(false)
  caption     String?
  uploadedAt  DateTime @default(now())
}

// -----------------------------------------
// SALES & TRANSACTIONS
// -----------------------------------------

model Customer {
  id        String   @id @default(uuid())
  nik       String?  @unique // Nomor KTP
  name      String
  phone     String
  address   String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
}

model Transaction {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique
  date          DateTime @default(now())

  // Relasi
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  motorId    String   @unique
  motor      Motor    @relation(fields: [motorId], references: [id], onDelete: Restrict)
  salesId    String?
  sales      User?    @relation("UserTransactions", fields: [salesId], references: [id], onDelete: SetNull)

  // Detail Transaksi
  paymentMethod String // CASH, CREDIT
  totalAmount   Int
  dpAmount      Int?

  // Detail Kredit
  leasingProvider String?
  tenor           Int?
  monthlyInstall  Int?

  status String // PENDING, COMPLETED, CANCELLED
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
