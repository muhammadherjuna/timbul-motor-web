generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  role      String   @default("sales") // admin, sales, mechanic
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inspections MotorInspection[]
  sales       MotorPricing[]
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  contact   String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pricings MotorPricing[]
}

model Motor {
  id   String @id @default(uuid())
  code String @unique

  // Tab 1: Identitas & Spesifikasi
  location     String?
  brand        String
  name         String
  type         String
  variant      String?
  year         Int
  color        String
  cc           Int
  transmission String
  fuel_system  String?
  key_type     String?
  km           Int

  // Tab 5: Foto & Video
  image            String
  images           String[]
  media_json       Json?
  videoUrl         String?
  video_cold_start String?

  description String

  status String // Draft, Tersedia, Sedang Dipesan, Terjual

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  document   MotorDocument?
  history    MotorHistory?
  inspection MotorInspection?
  pricing    MotorPricing?
  inspectionSessions InspectionSession[]
}

model MotorDocument {
  id      String @id @default(uuid())
  motorId String @unique
  motor   Motor  @relation(fields: [motorId], references: [id], onDelete: Cascade)

  plate_number   String?
  plate_area     String?
  tax_status     String
  tax_expiry     String
  stnk_expiry    String?
  stnk_status    String?
  bpkb_status    String?
  chassis_number String?
  engine_number  String?
  chassis_match  String?
  engine_match   String?
  faktur         String?
  ktp_owner      String?
  block_status   String?
  etle_status    String?

  bpkb_ready Boolean @default(true)
  stnk_ready Boolean @default(true)
}

model MotorHistory {
  id      String @id @default(uuid())
  motorId String @unique
  motor   Motor  @relation(fields: [motorId], references: [id], onDelete: Cascade)

  previous_owners String?
  usage_type      String?
  service_history String?
  last_service_km Int?
  crash_history   String?
  flood_history   String?
  engine_rebuild  String?
  modifications   String?
  odo_status      String?
}

model MotorInspection {
  id      String @id @default(uuid())
  motorId String @unique
  motor   Motor  @relation(fields: [motorId], references: [id], onDelete: Cascade)

  inspectorId String?
  inspector   User?   @relation(fields: [inspectorId], references: [id], onDelete: SetNull)
  inspector_name String?

  inspection_grade String?
  engine_start      String?
  engine_sound      String?
  cvt_chain         String?
  electrical_lights String?
  brakes            String?
  suspension        String?
  body_paint        String?
  test_drive        String?
  notes             String?
  repair_cost_est   Int?
  body_condition    String?
  engine_condition  String?

  archived          Boolean @default(false)
}

model MotorPricing {
  id      String @id @default(uuid())
  motorId String @unique
  motor   Motor  @relation(fields: [motorId], references: [id], onDelete: Cascade)

  price           Int
  credit_price    Int?
  is_nego         Boolean @default(true)
  dp_min          Int
  tenor_options   String?
  monthly_install Int?
  warranty        String?
  trade_in_avail  Boolean @default(true)

  purchase_price   Int?
  recondition_cost Int?
  margin_target    Int?

  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplier_name String?

  salesId    String?
  sales      User?   @relation(fields: [salesId], references: [id], onDelete: SetNull)
  sales_rep  String?

  internal_notes   String?
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  address   String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------
// SMART INSPECTION SYSTEM
// -----------------------------------------

model InspectionTemplate {
  id              String   @id @default(uuid())
  name            String
  version         String
  motorTypeFilter String   // all | matic | manual | sport
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  groups   InspectionTemplateGroup[]
  sessions InspectionSession[]
}

model InspectionTemplateGroup {
  id         String  @id @default(uuid())
  templateId String
  template   InspectionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String
  weight     Float
  orderIndex Int

  items InspectionTemplateItem[]
}

model InspectionTemplateItem {
  id              String  @id @default(uuid())
  groupId         String
  group           InspectionTemplateGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  itemKey         String  // unique slug
  question        String
  possibleAnswers Json    // array: {text, status, isCritical, score}
  applicableFor   String  // all | matic | manual | sport
  orderIndex      Int

  inspectionItems InspectionItem[]
}

model InspectionSession {
  id          String  @id @default(uuid())
  motorId     String
  motor       Motor   @relation(fields: [motorId], references: [id], onDelete: Cascade)
  templateId  String
  template    InspectionTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  status      String  // DRAFT | IN_PROGRESS | COMPLETED | APPROVED | REJECTED | REOPENED

  totalScore      Float?
  grade           String?  // A | B | C
  hasCritical     Boolean  @default(false)
  saleEligibility String?  // LAYAK_JUAL | PERLU_PERBAIKAN | TIDAK_LAYAK

  inspectorId   String?
  inspectorName String?

  approvedById   String?
  approvedByName String?
  approvalNote   String?
  approvedAt     DateTime?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  items InspectionItem[]
}

model InspectionItem {
  id             String  @id @default(uuid())
  sessionId      String
  session        InspectionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  templateItemId String
  templateItem   InspectionTemplateItem @relation(fields: [templateItemId], references: [id], onDelete: Restrict)

  answer     String
  status     String  // NORMAL | CATATAN | PERBAIKAN | KRITIS | BELUM_DIPERIKSA | TIDAK_BERLAKU
  isCritical Boolean @default(false)
  score      Float?

  notes       String?
  repairNote  String?
  repairedAt  DateTime?
  reVerifiedAt   DateTime?
  reVerifiedBy   String?

  evidence InspectionEvidence[]
}

model InspectionEvidence {
  id               String  @id @default(uuid())
  inspectionItemId String
  inspectionItem   InspectionItem @relation(fields: [inspectionItemId], references: [id], onDelete: Cascade)

  storagePath String
  isPublic    Boolean  @default(false)
  caption     String?
  uploadedAt  DateTime @default(now())
}

